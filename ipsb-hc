def queue_state_path(root: str, qm: str) -> str:
    return os.path.join(state_dir(root), f"{safe_name(qm)}_queue_seen.json")

def load_queue_state(root: str, qm: str) -> Dict[str, Any]:
    st = read_json_file(queue_state_path(root, qm))
    if not isinstance(st, dict) or st.get("schema") != 1:
        st = {"schema": 1, "seen": {}, "updated_at": None}
    st.setdefault("seen", {})
    return st

def save_queue_state(root: str, qm: str, st: Dict[str, Any]) -> None:
    ensure_dir(state_dir(root))
    st["updated_at"] = now_utc().isoformat()
    atomic_write_json(queue_state_path(root, qm), st)

def _thresholds_from_cfg(cfg: Dict[str, Any], qm: str, qname: str) -> Dict[str, Any]:
    defaults = cfg.get("defaults") if isinstance(cfg.get("defaults"), dict) else {}
    qmgrs = cfg.get("qmgrs") if isinstance(cfg.get("qmgrs"), dict) else {}
    qcfg = qmgrs.get(qm, {}) if isinstance(qmgrs.get(qm, {}), dict) else {}

    base: Dict[str, Any] = {}
    if isinstance(defaults.get("queue_thresholds"), dict):
        base.update(defaults["queue_thresholds"])
    if isinstance(qcfg.get("queue_thresholds"), dict):
        base.update(qcfg["queue_thresholds"])

    pat_list = qcfg.get("queue_pattern_overrides", [])
    if isinstance(pat_list, list):
        for item in pat_list:
            if not isinstance(item, dict):
                continue
            pat = item.get("pattern")
            thr = item.get("thresholds")
            if isinstance(pat, str) and isinstance(thr, dict) and fnmatch.fnmatch(qname, pat):
                base.update({k: v for k, v in thr.items()})

    ov = qcfg.get("queue_overrides")
    if isinstance(ov, dict):
        thr = ov.get(qname)
        if isinstance(thr, dict):
            base.update({k: v for k, v in thr.items()})

    return base

def _queue_assignment_group(cfg: Dict[str, Any], qm: str, qname: str) -> str:
    defaults = cfg.get("defaults") if isinstance(cfg.get("defaults"), dict) else {}
    qmgrs = cfg.get("qmgrs") if isinstance(cfg.get("qmgrs"), dict) else {}
    qcfg = qmgrs.get(qm, {}) if isinstance(qmgrs.get(qm, {}), dict) else {}

    ag = defaults.get("assignment_group", "OPS")
    if isinstance(qcfg.get("assignment_group"), str):
        ag = qcfg["assignment_group"]

    # exact routing
    gqroute = defaults.get("queue_routing", {})
    if isinstance(gqroute, dict) and isinstance(gqroute.get(qname), str):
        ag = gqroute[qname]
    qroute = qcfg.get("queue_routing", {})
    if isinstance(qroute, dict) and isinstance(qroute.get(qname), str):
        ag = qroute[qname]

    # pattern routing (qm-level)
    pr = qcfg.get("queue_pattern_routing", [])
    if isinstance(pr, list):
        for item in pr:
            if not isinstance(item, dict):
                continue
            pat = item.get("pattern")
            ag2 = item.get("assignment_group")
            if isinstance(pat, str) and isinstance(ag2, str) and fnmatch.fnmatch(qname, pat):
                ag = ag2
    return ag

def _queue_is_ignored(cfg: Dict[str, Any], qm: str, qname: str) -> bool:
    defaults = cfg.get("defaults") if isinstance(cfg.get("defaults"), dict) else {}
    qmgrs = cfg.get("qmgrs") if isinstance(cfg.get("qmgrs"), dict) else {}
    qcfg = qmgrs.get(qm, {}) if isinstance(qmgrs.get(qm, {}), dict) else {}

    pats: List[str] = []
    if isinstance(defaults.get("ignore_queue_patterns"), list):
        pats.extend([p for p in defaults["ignore_queue_patterns"] if isinstance(p, str)])
    if isinstance(qcfg.get("ignore_queue_patterns"), list):
        pats.extend([p for p in qcfg["ignore_queue_patterns"] if isinstance(p, str)])
    return any(fnmatch.fnmatch(qname, pat) for pat in pats)

def _required_queue_set(cfg: Dict[str, Any], qm: str, discovered: Dict[str, Dict[str, Any]]) -> List[str]:
    defaults = cfg.get("defaults") if isinstance(cfg.get("defaults"), dict) else {}
    qmgrs = cfg.get("qmgrs") if isinstance(cfg.get("qmgrs"), dict) else {}
    qcfg = qmgrs.get(qm, {}) if isinstance(qmgrs.get(qm, {}), dict) else {}

    req: List[str] = []
    for q in (defaults.get("required_queues") or []):
        if isinstance(q, str) and q not in req:
            req.append(q)
    for q in (qcfg.get("required_queues") or []):
        if isinstance(q, str) and q not in req:
            req.append(q)

    pats: List[str] = []
    for p in (defaults.get("required_queue_patterns") or []):
        if isinstance(p, str): pats.append(p)
    for p in (qcfg.get("required_queue_patterns") or []):
        if isinstance(p, str): pats.append(p)

    for pat in pats:
        for qname in discovered.keys():
            if fnmatch.fnmatch(qname, pat) and qname not in req:
                req.append(qname)
    return req

def parse_dis_qlocal_curdepth(text: str) -> Dict[str, Dict[str, Any]]:
    out: Dict[str, Dict[str, Any]] = {}
    q: Optional[str] = None
    for line in text.splitlines():
        line = line.strip()
        m = re.search(r"QUEUE\(([^)]+)\)", line, re.IGNORECASE)
        if m:
            q = m.group(1).strip()
            if q == "*":
                q = None
                continue
            out.setdefault(q, {})
        if q:
            m2 = re.search(r"CURDEP\((\d+)\)", line, re.IGNORECASE)
            if m2:
                out[q]["curdepth"] = int(m2.group(1))
            m3 = re.search(r"MAXDEPTH\((\d+)\)", line, re.IGNORECASE)
            if m3:
                out[q]["maxdepth"] = int(m3.group(1))
    return out

def evaluate_queue_depths(root: str, cfg: Dict[str, Any], qm: str, qdepths: Dict[str, Dict[str, Any]], node_host: str) -> List[Finding]:
    findings: List[Finding] = []
    st = load_queue_state(root, qm)
    seen = st.get("seen", {}) if isinstance(st.get("seen", {}), dict) else {}
    now = now_utc().isoformat()

    # learn
    for qname, meta in qdepths.items():
        cur = int(meta.get("curdepth", 0) or 0)
        if cur > 0:
            prev = seen.get(qname, {})
            seen[qname] = {"first_seen": prev.get("first_seen", now), "last_nonzero": now}
    st["seen"] = seen
    save_queue_state(root, qm, st)

    candidates = set(_required_queue_set(cfg, qm, qdepths))
    candidates.update(seen.keys())

    required = _required_queue_set(cfg, qm, qdepths)
    sev_missing = ((cfg.get("defaults", {}).get("queue_severity", {}) or {}).get("missing_required", "P2"))
    for rq in required:
        if rq not in qdepths and not _queue_is_ignored(cfg, qm, rq):
            ag = _queue_assignment_group(cfg, qm, rq)
            findings.append(Finding(priority=sev_missing, assignment_group=ag, reason_code="REQ_QUEUE_MISSING",
                                    domain="mq.queues", summary=f"Required local queue not defined: {qm}:{rq}",
                                    node=node_host, qm=qm))

    for qname in sorted(candidates):
        if qname not in qdepths or _queue_is_ignored(cfg, qm, qname):
            continue
        meta = qdepths[qname]
        cur = int(meta.get("curdepth", 0) or 0)
        maxd = int(meta.get("maxdepth", 0) or 0)

        thr = _thresholds_from_cfg(cfg, qm, qname)
        depth_warn = int(thr.get("depth_warn", 0) or 0)
        depth_crit = int(thr.get("depth_crit", 0) or 0)
        pct_crit = int(thr.get("pct_maxdepth_crit", 0) or 0)

        ag = _queue_assignment_group(cfg, qm, qname)

        if pct_crit > 0 and maxd > 0 and cur > 0:
            pct = int((cur * 100) / maxd)
            if pct >= pct_crit:
                findings.append(Finding(priority="P2", assignment_group=ag, reason_code="Q_NEAR_MAXDEPTH",
                                        domain="mq.queues",
                                        summary=f"Queue near MAXDEPTH ({pct}%): {qm}:{qname} CURDEP={cur} MAXDEPTH={maxd}",
                                        node=node_host, qm=qm))

        if depth_crit > 0 and cur >= depth_crit:
            findings.append(Finding(priority="P2", assignment_group=ag, reason_code="Q_DEPTH_HIGH",
                                    domain="mq.queues",
                                    summary=f"Queue depth high (crit): {qm}:{qname} CURDEP={cur} (>= {depth_crit})",
                                    node=node_host, qm=qm))
        elif depth_warn > 0 and cur >= depth_warn:
            findings.append(Finding(priority="P3", assignment_group=ag, reason_code="Q_DEPTH_HIGH",
                                    domain="mq.queues",
                                    summary=f"Queue depth high (warn): {qm}:{qname} CURDEP={cur} (>= {depth_warn})",
                                    node=node_host, qm=qm))
    return findings

