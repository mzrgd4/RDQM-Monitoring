def utc_now() -> _dt.datetime:
    return _dt.datetime.now(tz=_dt.timezone.utc)

def iso(dt: _dt.datetime) -> str:
    return dt.astimezone(_dt.timezone.utc).isoformat()

def atomic_write_text(path: str, content: str) -> None:
    tmp = f"{path}.tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(content)
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, path)

def atomic_write_json(path: str, obj: Any) -> None:
    atomic_write_text(path, json.dumps(obj, indent=2, sort_keys=True) + "\n")

def write_breadcrumb(msg: str) -> None:
    ts = iso(utc_now())
    line = f"{ts} | {msg}\n"
    try:
        with open("/tmp/ipsb-hc-breadcrumb.log", "a", encoding="utf-8") as f:
            f.write(line)
    except Exception:
        pass

def require_mqm_or_warn() -> Optional[str]:
    try:
        import getpass
        user = getpass.getuser()
        if user != "mqm":
            return f"Must run as mqm (current user: {user})"
    except Exception:
        return None
    return None

@dataclass
class Finding:
    priority: str
    assignment_group: str
    reason_code: str
    domain: str
    summary: str
    node: Optional[str] = None
    qm: Optional[str] = None
    queue: Optional[str] = None

    def to_dict(self) -> Dict[str, Any]:
        d = {
            "priority": self.priority,
            "assignment_group": self.assignment_group,
            "reason_code": self.reason_code,
            "domain": self.domain,
            "summary": self.summary,
            "node": self.node,
        }
        if self.qm:
            d["qm"] = self.qm
        if self.queue:
            d["queue"] = self.queue
        return d

def read_json_file(path: str) -> Optional[Dict[str, Any]]:
    try:
        with open(path, "r", encoding="utf-8") as f:
            return json.load(f)
    except FileNotFoundError:
        return None
    except Exception as e:
        write_breadcrumb(f"Failed to read JSON {path}: {e}")
        return None


