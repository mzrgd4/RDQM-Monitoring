def load_or_bootstrap_config(root: str, discovered_qms: List[str]) -> Dict[str, Any]:
    path = config_path(root)
    cfg = read_json_file(path)
    if not isinstance(cfg, dict) or cfg.get("schema") != 1:
        cfg = default_config()

    cfg.setdefault("defaults", {})
    cfg.setdefault("qmgrs", {})

    qmgrs = cfg.get("qmgrs")
    if not isinstance(qmgrs, dict):
        qmgrs = {}
        cfg["qmgrs"] = qmgrs

    changed = False
    for qm in discovered_qms:
        if qm not in qmgrs:
            qmgrs[qm] = {
                "assignment_group": cfg["defaults"].get("assignment_group", "OPS"),
                "ignore_channel_patterns": [],
                "required_sdr_channels": [],
                "required_sdr_patterns": [],
                "routing": {},
                "severity": {},
                "ignore_queue_patterns": [],
                "required_queues": [],
                "required_queue_patterns": [],
                "queue_thresholds": {},
                "queue_severity": {},
                "queue_overrides": {},
                "queue_pattern_overrides": [],
                "queue_routing": {},
                "queue_pattern_routing": [],
            }
            changed = True

    try:
        ensure_dir(os.path.dirname(path))
        if (read_json_file(path) is None) or changed:
            atomic_write_json(path, cfg)
    except Exception as e:
        write_breadcrumb(f"Config bootstrap/write failed at {path}: {e}")

    return cfg

def _merge_list(a: Any, b: Any) -> List[str]:
    out: List[str] = []
    for x in (a or []):
        if isinstance(x, str):
            out.append(x)
    for x in (b or []):
        if isinstance(x, str):
            out.append(x)
    seen=set()
    dedup=[]
    for x in out:
        if x not in seen:
            dedup.append(x); seen.add(x)
    return dedup

def _merge_dict(a: Any, b: Any) -> Dict[str, str]:
    out: Dict[str, str] = {}
    if isinstance(a, dict):
        for k, v in a.items():
            if isinstance(k, str) and isinstance(v, str):
                out[k] = v
    if isinstance(b, dict):
        for k, v in b.items():
            if isinstance(k, str) and isinstance(v, str):
                out[k] = v
    return out

def evaluate_required_sdr_channels(
    cfg: Dict[str, Any],
    qm: str,
    sdr_map: Dict[str, Dict[str, Any]],
    node_host: str,
) -> List[Finding]:
    findings: List[Finding] = []
    defaults = cfg.get("defaults") if isinstance(cfg.get("defaults"), dict) else {}
    qcfg = (cfg.get("qmgrs") or {}).get(qm, {}) if isinstance(cfg.get("qmgrs"), dict) else {}
    if not isinstance(qcfg, dict):
        qcfg = {}

    assignment_default = qcfg.get("assignment_group") or defaults.get("assignment_group") or "OPS"
    ignore_patterns = _merge_list(defaults.get("ignore_channel_patterns"), qcfg.get("ignore_channel_patterns"))
    req_channels = _merge_list(defaults.get("required_sdr_channels"), qcfg.get("required_sdr_channels"))
    req_patterns = _merge_list(defaults.get("required_sdr_patterns"), qcfg.get("required_sdr_patterns"))
    routing = _merge_dict(defaults.get("routing"), qcfg.get("routing"))
    sev = _merge_dict(defaults.get("severity"), qcfg.get("severity"))

    sev_missing = sev.get("missing_required", "P2")
    sev_stopped = sev.get("stopped_required", "P3")
    sev_retrying = sev.get("retrying_required", "P4")

    def is_ignored(ch: str) -> bool:
        for pat in ignore_patterns:
            if fnmatch.fnmatch(ch, pat):
                return True
        return False

    required: List[str] = []
    for ch in req_channels:
        if ch not in required:
            required.append(ch)
    for pat in req_patterns:
        for ch, meta in sdr_map.items():
            if meta.get("defined") is True and fnmatch.fnmatch(ch, pat) and ch not in required:
                required.append(ch)

    for ch in required:
        meta = sdr_map.get(ch)
        if meta is None:
            ag = routing.get(ch, assignment_default)
            findings.append(Finding(
                priority=sev_missing,
                assignment_group=ag,
                reason_code="REQ_SDR_MISSING",
                domain="mq.channels",
                summary=f"Required SDR channel not defined: {qm}:{ch}",
                node=node_host,
                qm=qm,
            ))
            continue

        # Option A: NO_STATUS is neutral
        status = (meta.get("status") or "UNKNOWN").upper()
        if status in ("NO_STATUS", "UNKNOWN"):
            continue

        if is_ignored(ch) and ch not in req_channels and not any(fnmatch.fnmatch(ch, p) for p in req_patterns):
            continue

        if status in ("RETRYING", "PAUSED", "STOPPING"):
            ag = routing.get(ch, assignment_default)
            findings.append(Finding(
                priority=sev_retrying,
                assignment_group=ag,
                reason_code="REQ_SDR_NOT_HEALTHY",
                domain="mq.channels",
                summary=f"Required SDR channel unhealthy ({status}): {qm}:{ch}",
                node=node_host,
                qm=qm,
            ))
        elif status in ("STOPPED", "INACTIVE", "ENDED"):
            ag = routing.get(ch, assignment_default)
            findings.append(Finding(
                priority=sev_stopped,
                assignment_group=ag,
                reason_code="REQ_SDR_STOPPED",
                domain="mq.channels",
                summary=f"Required SDR channel stopped/inactive ({status}): {qm}:{ch}",
                node=node_host,
                qm=qm,
            ))

    return findings

